{
  "name": "web-app",
  "private": true,
  "engines": { "node": ">=22" },
  "scripts": {
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "lint:arch": "dependency-cruiser src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/index.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.1.2",
    "dependency-cruiser": "16.10.0",
    "typescript": "5.6.3",
    "vitest": "2.1.8"
  }
}
